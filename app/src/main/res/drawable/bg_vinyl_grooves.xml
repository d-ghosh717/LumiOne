<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vinyl Disc Outer Body -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#141416" />
            <stroke android:width="2dp" android:color="#24242A" />
        </shape>
    </item>

    <!-- Outer Vinyl Groove Ring -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1F1F24" />
        </shape>
    </item>

    <!-- Second Groove Ring -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#282830" />
        </shape>
    </item>

    <!-- Third Groove Ring -->
    <item android:top="24dp" android:bottom="24dp" android:left="24dp" android:right="24dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1E1E22" />
        </shape>
    </item>

    <!-- Fourth Groove Ring -->
    <item android:top="32dp" android:bottom="32dp" android:left="32dp" android:right="32dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#25252C" />
        </shape>
    </item>
</layer-list>
