<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlistTrackRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_track_item_normal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <!-- Track Number -->
        <TextView
            android:id="@+id/playlistTrackNumber"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="1"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="@font/plus_jakarta_sans" />

        <!-- Artwork Squircle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playlistTrackArtworkCard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_toEndOf="@+id/playlistTrackNumber"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/surface">

            <ImageView
                android:id="@+id/playlistTrackArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_album_art_placeholder"
                android:contentDescription="Track cover" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Track Title & Artist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/playlistTrackArtworkCard"
            android:layout_toStartOf="@+id/btnRemoveFromPlaylist"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/playlistTrackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist • 3:45"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Remove from playlist contextual button -->
        <ImageButton
            android:id="@+id/btnRemoveFromPlaylist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:tint="@color/text_dim"
            android:contentDescription="Remove track from playlist" />
    </RelativeLayout>
</LinearLayout>
