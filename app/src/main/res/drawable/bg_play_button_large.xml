<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Soft outer coral glow ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#40FF5A5F" />
                    <size android:width="76dp" android:height="76dp" />
                </shape>
            </item>
            <!-- Base physical gradient circle (Sunset Pop) -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#FF5A5F"
                        android:centerColor="#FF8A3D"
                        android:endColor="#FF2E88" />
                    <stroke android:width="1.5dp" android:color="#99FFD166" />
                </shape>
            </item>
            <!-- Top glossy glass highlight -->
            <item android:top="4dp" android:bottom="36dp" android:left="14dp" android:right="14dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
