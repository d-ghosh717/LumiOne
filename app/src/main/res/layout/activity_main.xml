<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- ─── Main Content Scroll (Explore Dashboard) ────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/miniPlayerCard"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <!-- Top Editorial Header inspired by Reference Screen 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LUMIONE MUSIC"
                        android:textColor="@color/primary_lavender"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Explore"
                        android:textColor="@color/text_primary"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="-0.03" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/primary_lavender"
                    android:contentDescription="Settings" />
            </RelativeLayout>

            <!-- Floating Glass Search Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_field"
                    android:hint="Search artists, tracks, soundscapes…"
                    android:textColorHint="@color/text_dim"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="52dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/primary_bright" />
            </FrameLayout>

            <!-- Section Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trending Now"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/btnSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="See all"
                    android:textColor="@color/primary_lavender"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <!-- Asymmetrical / Editorial Music Stream -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchResultsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─── Floating Glass Mini Player ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/miniPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_above="@+id/bottomNavBar"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mini_player"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Circular Album Art Disc -->
        <ImageView
            android:id="@+id/miniAlbumArtView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_album_art_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/miniTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nothing playing"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:ellipsize="marquee" />

            <TextView
                android:id="@+id/miniArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="@color/primary_lavender"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/miniPlayPauseBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_play_button_mini"
            android:src="@drawable/ic_play"
            android:tint="@color/text_primary"
            android:contentDescription="Play/Pause" />
    </LinearLayout>

    <!-- Mini Progress Line -->
    <ProgressBar
        android:id="@+id/miniProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_above="@+id/bottomNavBar"
        android:progressDrawable="@drawable/progress_gradient"
        android:max="1000"
        android:progress="0" />

    <!-- ─── Floating Minimalist Navigation Dock (Inspired by Reference) ───── -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="14dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill" />

            <ImageButton
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_home"
                android:tint="@color/primary_lavender"
                android:background="@null"
                android:contentDescription="Home" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_disc_planet"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Explore" />

        <ImageButton
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_library"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Library" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Profile" />
    </LinearLayout>

    <!-- ─── Full Player Hardware Deck Overlay (Screen 2 Inspiration) ──────── -->
    <FrameLayout
        android:id="@+id/fullPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_full_player_gradient"
        android:visibility="gone"
        android:elevation="24dp"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="42dp"
                android:paddingHorizontal="24dp"
                android:paddingBottom="36dp">

                <!-- Top Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="@color/text_primary"
                        android:contentDescription="Collapse" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="NOW PLAYING"
                        android:textColor="@color/primary_lavender"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <ImageButton
                        android:id="@+id/btnMore"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_more_vert"
                        android:tint="@color/text_primary"
                        android:contentDescription="Options" />
                </RelativeLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="14dp" />

                <!-- Physical Turntable Hardware Deck (Inspired by Reference Screen 2) -->
                <FrameLayout
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_turntable_hardware"
                    android:padding="16dp"
                    android:elevation="8dp">

                    <!-- Corner Mechanical Accents (3 circular screw points from reference) -->
                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_pill" />

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_pill" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_pill" />

                    <!-- Vinyl Groove Centerpiece Ring -->
                    <View
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_album_art_large" />

                    <!-- Circular Record / Artwork Disc -->
                    <ImageView
                        android:id="@+id/fullAlbumArtView"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_album_art_placeholder"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:elevation="6dp" />
                </FrameLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="14dp" />

                <!-- Editorial Song Metadata (Inspired by Reference Screen 2) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/btnLike"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fullTrackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select a track"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="-0.02"
                            android:singleLine="true"
                            android:ellipsize="marquee" />

                        <TextView
                            android:id="@+id/fullArtistName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="@color/primary_lavender"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnLike"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_heart"
                        android:tint="@color/primary_lavender"
                        android:contentDescription="Favorite" />
                </RelativeLayout>

                <!-- Soundwave & Time Tracker inspired by Reference Screen 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        android:tint="@color/primary_bright"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/fullCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/primary_lavender"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / "
                            android:textColor="@color/text_dim"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope" />

                        <TextView
                            android:id="@+id/fullDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/text_muted"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seekbar -->
                <SeekBar
                    android:id="@+id/fullSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/seekbar_gradient"
                    android:thumb="@drawable/seekbar_thumb"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingVertical="10dp"
                    android:max="1000"
                    android:layout_marginBottom="16dp" />

                <!-- Tactile Physical Control Deck inspired by Reference Screen 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_control_deck"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:elevation="10dp">

                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text_primary"
                        android:alpha="0.4"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Tactile Previous Pill Button -->
                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="58dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_skip_prev"
                        android:tint="@color/text_primary"
                        android:background="@drawable/bg_control_pill_button"
                        android:contentDescription="Previous" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <!-- Tactile Concave Circular Play Button inspired by Reference -->
                    <ImageButton
                        android:id="@+id/fullPlayPauseBtn"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:background="@drawable/bg_tactile_play_button"
                        android:src="@drawable/ic_play"
                        android:tint="@color/text_primary"
                        android:scaleType="centerInside"
                        android:elevation="12dp"
                        android:contentDescription="Play/Pause" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <!-- Tactile Next Pill Button -->
                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="58dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary"
                        android:background="@drawable/bg_control_pill_button"
                        android:contentDescription="Next" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/text_primary"
                        android:alpha="0.4"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat" />

                </LinearLayout>

                <!-- Bottom Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="8dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</RelativeLayout>
