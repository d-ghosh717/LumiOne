<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Platter Ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#2D134A"
                android:centerColor="#1B0A2E"
                android:endColor="#0F051C" />
            <stroke android:width="2dp" android:color="#4DA855F7" />
        </shape>
    </item>
    <!-- Concentric Groove Ring 1 -->
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#26C084FC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Concentric Groove Ring 2 -->
    <item
        android:top="32dp"
        android:bottom="32dp"
        android:left="32dp"
        android:right="32dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1FC084FC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
