<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Inset Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1520" />
            <stroke android:width="1dp" android:color="#40FF8A3D" />
        </shape>
    </item>
    <!-- Metallic Screw Center with Golden/Amber Tone -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#8A6B2D"
                android:centerColor="#4A3B18"
                android:endColor="#2B210F"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
