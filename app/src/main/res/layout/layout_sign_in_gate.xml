<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signInGateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:clickable="true"
    android:focusable="true"
    android:elevation="50dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="LumiOne" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your music, in sync"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Sign in with Google to save your library, listening history, and playlists to your account."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:fontFamily="@font/manrope" />

        <TextView
            android:id="@+id/signInErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/coral"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueWithGoogle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Continue with Google"
            android:textAllCaps="false"
            android:textColor="@color/text_on_cyan"
            android:textSize="16sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:backgroundTint="@color/primary_cyan"
            android:contentDescription="Continue with Google" />

        <ProgressBar
            android:id="@+id/signInProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/primary_cyan"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
