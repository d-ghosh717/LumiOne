<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:id="@+id/nowPlayingScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/btnCollapseNowPlaying"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="@color/text_primary"
                    android:contentDescription="Collapse" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="NOW PLAYING"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:fontFamily="@font/plus_jakarta_sans" />

            </RelativeLayout>

            <!-- Flexible Space -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="12dp" />

            <!-- Turntable Platter Deck with Rotating Vinyl -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_gravity="center_horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="290dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_turntable_deck"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="12dp">

                    <!-- Mathematically Precise Single-Unit Vinyl Disc -->
                    <com.lumione.player.ui.VinylDiscView
                        android:id="@+id/nowPlayingVinylDisc"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="8dp" />

                    <!-- Turntable Tonearm (Pivots smoothly over rotating vinyl) -->
                    <ImageView
                        android:id="@+id/turntableTonearm"
                        android:layout_width="76dp"
                        android:layout_height="192dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_turntable_arm"
                        android:contentDescription="Turntable tonearm" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Flexible Space -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="14dp" />

            <!-- Track Info & Heart Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/nowPlayingTrackActions"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fullTrackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Not Playing"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="-0.02"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />

                    <TextView
                        android:id="@+id/fullArtistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select a track to start listening"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nowPlayingTrackActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnNowPlayingAddToPlaylist"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_playlist"
                        android:tint="@color/text_muted"
                        android:contentDescription="Add to playlist" />

                    <ImageButton
                        android:id="@+id/btnNowPlayingLike"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_heart"
                        android:tint="@color/text_muted"
                        android:contentDescription="Like track" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Cyan Waveform Visualization (LumiOne Pulse) -->
            <com.lumione.player.ui.CyanWaveformView
                android:id="@+id/nowPlayingWaveform"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- Seekbar & Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <SeekBar
                    android:id="@+id/fullSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/seekbar_gradient"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/fullCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="0:00"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />

                    <TextView
                        android:id="@+id/fullDurationTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0:00"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Transport Playback Controls (Mathematically Symmetrical Spacing) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Shuffle -->
                <ImageButton
                    android:id="@+id/btnFullShuffle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_shuffle"
                    android:tint="@color/text_dim"
                    android:contentDescription="Shuffle" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Prev -->
                <ImageButton
                    android:id="@+id/btnFullPrev"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_skip_prev"
                    android:tint="@color/text_primary"
                    android:contentDescription="Previous" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Main Play/Pause Tactile Button -->
                <FrameLayout
                    android:id="@+id/btnFullPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_tactile_play_button"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/fullPlayPauseIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play"
                        android:tint="@color/text_on_cyan"
                        android:contentDescription="Play/Pause" />

                    <ProgressBar
                        android:id="@+id/trackPreparingIndicator"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary_cyan"
                        android:visibility="gone" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Next -->
                <ImageButton
                    android:id="@+id/btnFullNext"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/text_primary"
                    android:contentDescription="Next" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Repeat -->
                <ImageButton
                    android:id="@+id/btnFullRepeat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_repeat"
                    android:tint="@color/text_dim"
                    android:contentDescription="Repeat" />
            </LinearLayout>

            <!-- Bottom Badge (Engine / Quality) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_soundwave"
                    android:tint="@color/primary_cyan"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/fullQualityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LumiOne HD • 320 kbps"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nowPlayingUpNextSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Up Next"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/nowPlayingQueueCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 tracks"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nowPlayingQueueEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_track_item_normal"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No upcoming tracks"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nowPlayingUpNextRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
