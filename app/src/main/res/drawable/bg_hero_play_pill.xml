<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40F5D0FE">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#33A855F7" />
                </shape>
            </item>
            <item
                android:top="1.5dp"
                android:bottom="1.5dp"
                android:left="1.5dp"
                android:right="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#C084FC"
                        android:centerColor="#9333EA"
                        android:endColor="#6B21A8"
                        android:type="linear" />
                    <stroke android:width="1dp" android:color="#80F5D0FE" />
                </shape>
            </item>
            <item
                android:top="2.5dp"
                android:left="8dp"
                android:right="8dp"
                android:height="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="1dp" />
                    <solid android:color="#4DF5D0FE" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
