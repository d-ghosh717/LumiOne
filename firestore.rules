rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User document and user-scoped personal data subcollections
    match /users/{uid} {
      // User root document
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 1. Favorites synchronization (/users/{uid}/favorites/{favoriteId})
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 2. Listening history synchronization (/users/{uid}/history/{historyId})
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 3. Five most recent searches synchronization (/users/{uid}/recentSearches/{searchId})
      match /recentSearches/{searchId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 4. User playlists synchronization (/users/{uid}/playlists/{playlistId})
      match /playlists/{playlistId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

