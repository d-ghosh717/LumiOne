<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/trackCardContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_track_item_normal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Circular Vinyl Disc Platter -->
        <FrameLayout
            android:id="@+id/resultDiscPlatter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerVertical="true">

            <!-- Grooved Vinyl Disc Background -->
            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_vinyl_grooves" />

            <!-- Circular Center Label Album Artwork -->
            <ImageView
                android:id="@+id/resultThumbnail"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_album_art_placeholder"
                android:scaleType="centerCrop"
                android:contentDescription="Track album artwork" />

            <!-- Spindle Center Hole -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_vinyl_spindle" />
        </FrameLayout>

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/resultActionPill"
            android:layout_toEndOf="@+id/resultDiscPlatter"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/resultArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Play / Duration Pill Action -->
        <LinearLayout
            android:id="@+id/resultActionPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_play_chip"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:elevation="1dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/resultPlayIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_play"
                android:tint="@color/primary_cyan"
                android:layout_marginEnd="5dp"
                android:contentDescription="Play action" />

            <TextView
                android:id="@+id/resultDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ice_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
