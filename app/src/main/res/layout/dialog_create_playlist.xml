<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_track_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogPlaylistHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Playlist"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans" />

    <TextView
        android:id="@+id/dialogPlaylistSubheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Give your playlist a memorable name."
        android:textColor="@color/text_muted"
        android:textSize="12.5sp"
        android:fontFamily="@font/manrope" />

    <EditText
        android:id="@+id/editPlaylistName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_search_field"
        android:paddingHorizontal="14dp"
        android:hint="My Playlist"
        android:textColorHint="@color/text_dim"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:singleLine="true"
        android:maxLength="50"
        android:fontFamily="@font/manrope" />

    <TextView
        android:id="@+id/playlistNameError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/coral"
        android:textSize="12sp"
        android:fontFamily="@font/manrope"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editPlaylistDesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_field"
        android:paddingHorizontal="14dp"
        android:hint="Description (optional)"
        android:textColorHint="@color/text_dim"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:singleLine="true"
        android:maxLength="100"
        android:fontFamily="@font/manrope" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelPlaylistDialog"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Cancel"
            android:textColor="@color/text_muted"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:id="@+id/btnConfirmPlaylistDialog"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hero_play_pill"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Create"
            android:textColor="@color/text_on_cyan"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

</LinearLayout>
