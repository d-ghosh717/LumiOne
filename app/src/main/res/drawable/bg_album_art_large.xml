<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient outer shadow / glow ring -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26A855F7" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Artwork base -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#581C87"
                android:centerColor="#3B0764"
                android:endColor="#1E1133" />
            <stroke android:width="1dp" android:color="#40C084FC" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
