<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40C084FC">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2D1B4E"
                        android:endColor="#1C1032"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#33A855F7" />
                </shape>
            </item>
            <item
                android:left="6dp"
                android:right="6dp"
                android:top="2dp"
                android:height="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="1dp" />
                    <solid android:color="#26F0ABFC" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
