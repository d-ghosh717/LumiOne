<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vinyl Outer Rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="48dp"
                android:startColor="#3B185F"
                android:centerColor="#240E40"
                android:endColor="#140726" />
            <stroke android:width="1.5dp" android:color="#4DA855F7" />
        </shape>
    </item>
    <!-- Vinyl Concentric Groove 1 -->
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#26C084FC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Vinyl Center Spindle Label -->
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#8B5CF6"
                android:endColor="#5B21B6" />
            <stroke android:width="1dp" android:color="#80F5D0FE" />
        </shape>
    </item>
</layer-list>
