<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Dim Scrim Background -->
    <View
        android:id="@+id/navDrawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" />

    <!-- Left-Sliding Liquid Glass Menu Panel -->
    <LinearLayout
        android:id="@+id/navDrawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_app_gradient"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp"
        android:elevation="16dp">

        <!-- Header: Logo, Title & Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_lumione_logo"
                    android:contentDescription="LumiOne" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LUMIONE"
                        android:textColor="@color/primary_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound &amp; Discovery"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnCloseDrawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_primary"
                    android:contentDescription="Close Menu" />
            </FrameLayout>
        </RelativeLayout>

        <!-- User Quick Card -->
        <LinearLayout
            android:id="@+id/drawerUserCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_track_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/subtle_border"
                app:cardBackgroundColor="@color/surface">

                <ImageView
                    android:id="@+id/drawerAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/text_muted"
                    android:padding="8dp"
                    android:contentDescription="User Avatar" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/drawerUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest Listener"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:id="@+id/drawerUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to manage account"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:fontFamily="@font/manrope" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigation Menu Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAVIGATION"
                    android:textColor="@color/primary_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginBottom="8dp" />

                <!-- Item 1: Home -->
                <LinearLayout
                    android:id="@+id/drawerItemHome"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_home"
                        android:tint="@color/primary_cyan"
                        android:contentDescription="Home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Explore &amp; Trending"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>

                <!-- Item 2: Search -->
                <LinearLayout
                    android:id="@+id/drawerItemSearch"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_muted"
                        android:contentDescription="Search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Search Music"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <!-- Item 3: Library -->
                <LinearLayout
                    android:id="@+id/drawerItemLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_library"
                        android:tint="@color/text_muted"
                        android:contentDescription="Library" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Your Library"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <!-- Item 4: Liked Songs -->
                <LinearLayout
                    android:id="@+id/drawerItemFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_heart"
                        android:tint="@color/coral"
                        android:contentDescription="Liked Songs" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Liked Songs"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />

                    <TextView
                        android:id="@+id/drawerFavoritesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <!-- Item 5: Listening History -->
                <LinearLayout
                    android:id="@+id/drawerItemHistory"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_history"
                        android:tint="@color/ice_blue"
                        android:contentDescription="History" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Listening History"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />

                    <TextView
                        android:id="@+id/drawerHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <!-- Item 6: Queue -->
                <LinearLayout
                    android:id="@+id/drawerItemQueue"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_queue"
                        android:tint="@color/primary_cyan"
                        android:contentDescription="Queue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Up Next Queue"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/subtle_border"
                    android:layout_marginVertical="12dp" />

                <!-- Item 7: Profile & Settings -->
                <LinearLayout
                    android:id="@+id/drawerItemProfile"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/text_muted"
                        android:contentDescription="Settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Profile &amp; Settings"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Footer Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LumiOne v1.0.0 • 320 kbps HD"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
