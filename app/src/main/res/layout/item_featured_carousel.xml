<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="290dp"
    android:layout_height="224dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#16171E"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-bleed Album Artwork -->
        <ImageView
            android:id="@+id/carouselArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Featured album artwork" />

        <!-- Ambient Bottom Gradient Scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_full_player_gradient" />

        <!-- Docked Frosted Glass Pill Overlay -->
        <LinearLayout
            android:id="@+id/carouselPillDock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_docked_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/carouselTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track Title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:singleLine="true"
                    android:ellipsize="marquee" />

                <TextView
                    android:id="@+id/carouselArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Artist"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/manrope"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Play / Pause Button in Pill -->
            <FrameLayout
                android:id="@+id/carouselPlayBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:id="@+id/carouselPlayIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_primary"
                    android:contentDescription="Play track" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
