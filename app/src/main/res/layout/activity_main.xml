<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <!-- ─── Main Content Views Container ───────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Home / Explore Tab -->
        <include
            android:id="@+id/includeHome"
            layout="@layout/layout_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- 2. Search Tab -->
        <include
            android:id="@+id/includeSearch"
            layout="@layout/layout_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 3. Library Tab -->
        <include
            android:id="@+id/includeLibrary"
            layout="@layout/layout_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 4. Profile Tab -->
        <include
            android:id="@+id/includeProfile"
            layout="@layout/layout_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ─── Floating Mini Player ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/miniPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_above="@+id/bottomNavBar"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mini_player"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        android:elevation="14dp">

        <!-- Album Art Squircle -->
        <ImageView
            android:id="@+id/miniAlbumArtView"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_album_art_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Mini album art" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/miniTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not playing"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <TextView
                android:id="@+id/miniArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/miniPlayPauseBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_play_button_mini"
            android:src="@drawable/ic_play"
            android:tint="@color/text_on_cyan"
            android:contentDescription="Play/Pause" />

        <!-- Skip Next Button -->
        <ImageButton
            android:id="@+id/miniNextBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_muted"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Mini Progress Line -->
    <ProgressBar
        android:id="@+id/miniProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/bottomNavBar"
        android:layout_marginHorizontal="20dp"
        android:progressDrawable="@drawable/progress_gradient"
        android:max="1000"
        android:progress="0"
        android:elevation="15dp"
        android:visibility="gone" />

    <!-- ─── Floating Minimalist Navigation Dock ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:elevation="16dp">

        <!-- Tab 0: Home -->
        <FrameLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:clickable="true"
            android:focusable="true">

            <!-- Active Capsule Pill -->
            <LinearLayout
                android:id="@+id/pillHomeActive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_on_cyan"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Home"
                    android:textColor="@color/text_on_cyan"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <!-- Inactive Circular Button -->
            <FrameLayout
                android:id="@+id/circleHomeInactive"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_inactive_circle"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_muted"
                    android:contentDescription="Home" />
            </FrameLayout>
        </FrameLayout>

        <!-- Tab 1: Search -->
        <FrameLayout
            android:id="@+id/navTabSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillSearchActive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_on_cyan"
                    android:contentDescription="Search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Search"
                    android:textColor="@color/text_on_cyan"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/circleSearchInactive"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_inactive_circle">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_muted"
                    android:contentDescription="Search" />
            </FrameLayout>
        </FrameLayout>

        <!-- Tab 2: Library -->
        <FrameLayout
            android:id="@+id/navTabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillLibraryActive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_library"
                    android:tint="@color/text_on_cyan"
                    android:contentDescription="Library" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Library"
                    android:textColor="@color/text_on_cyan"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/circleLibraryInactive"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_inactive_circle">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_library"
                    android:tint="@color/text_muted"
                    android:contentDescription="Library" />
            </FrameLayout>
        </FrameLayout>

        <!-- Tab 3: Profile -->
        <FrameLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillProfileActive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/text_on_cyan"
                    android:contentDescription="Profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Profile"
                    android:textColor="@color/text_on_cyan"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/circleProfileInactive"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_inactive_circle">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/text_muted"
                    android:contentDescription="Profile" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ─── Playlist Detail Overlay ────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/playlistDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="27dp">

        <include
            android:id="@+id/includePlaylistDetail"
            layout="@layout/layout_playlist_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ─── Queue Sheet Overlay ────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/queueSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="28dp">

        <include
            android:id="@+id/includeQueueSheet"
            layout="@layout/layout_queue_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ─── Full Player Overlay ────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fullPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="30dp">

        <include
            android:id="@+id/includeNowPlaying"
            layout="@layout/layout_now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ─── Side Navigation Drawer Overlay ─────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/navDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="35dp">

        <include
            android:id="@+id/includeNavDrawer"
            layout="@layout/layout_navigation_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <include
        android:id="@+id/signInGate"
        layout="@layout/layout_sign_in_gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>
