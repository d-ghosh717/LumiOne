<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_track_item"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <RelativeLayout
        android:id="@+id/trackCardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_track_card"
        android:clickable="false"
        android:focusable="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Circular Album Art inspired by reference -->
        <ImageView
            android:id="@+id/resultThumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_album_art_placeholder"
            android:scaleType="centerCrop"
            android:clickable="false"
            android:focusable="false"
            android:clipToOutline="true" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/resultActionPill"
            android:layout_toEndOf="@+id/resultThumbnail"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:clickable="false"
                android:focusable="false"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/resultArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/primary_lavender"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true"
                android:clickable="false"
                android:focusable="false"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Play Pill Action inspired by reference -->
        <LinearLayout
            android:id="@+id/resultActionPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_play_chip"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/resultPlayIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_play"
                android:tint="@color/primary_bright"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/resultDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_violet"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
