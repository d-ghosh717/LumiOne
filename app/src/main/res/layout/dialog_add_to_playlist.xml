<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_track_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add to Playlist"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans" />

    <TextView
        android:id="@+id/dialogAddToPlaylistSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select a personal playlist for this song"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/manrope"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Button: + New Playlist -->
    <LinearLayout
        android:id="@+id/btnDialogCreateNewPlaylist"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_add"
            android:tint="@color/primary_cyan"
            android:contentDescription="New playlist" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Create New Playlist"
            android:textColor="@color/primary_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

    <!-- Empty state if 0 playlists -->
    <TextView
        android:id="@+id/txtDialogNoPlaylists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="You don't have any playlists yet.\nTap above to create your first playlist."
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/manrope"
        android:visibility="gone" />

    <!-- Playlists list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogPlaylists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="260dp"
        android:overScrollMode="never" />

    <!-- Close button -->
    <TextView
        android:id="@+id/btnCancelAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
