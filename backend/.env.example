# Public Firebase Web client configuration. These values are delivered to browsers.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Server-only Firebase Admin credentials; configure in Render, never in the web client.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
