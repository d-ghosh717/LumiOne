<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40C084FC">
    <item>
        <layer-list>
            <!-- Outer Glow Ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33A855F7" />
                </shape>
            </item>
            <!-- Concave Base Well -->
            <item
                android:top="3dp"
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="42dp"
                        android:startColor="#140822"
                        android:endColor="#2D1950" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#66C084FC" />
                </shape>
            </item>
            <!-- Raised Physical Center Button -->
            <item
                android:top="7dp"
                android:bottom="7dp"
                android:left="7dp"
                android:right="7dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#A855F7"
                        android:centerColor="#8B5CF6"
                        android:endColor="#5B21B6" />
                    <stroke
                        android:width="1dp"
                        android:color="#80F5D0FE" />
                </shape>
            </item>
            <!-- Top Gloss Highlight -->
            <item
                android:top="9dp"
                android:left="18dp"
                android:right="18dp"
                android:height="4dp">
                <shape android:shape="oval">
                    <solid android:color="#4DF5D0FE" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
