<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="5dp"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/trackCardContainer"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_track_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Circular Album Art Disc -->
        <ImageView
            android:id="@+id/resultThumbnail"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_album_art_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:elevation="4dp" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/resultActionPill"
            android:layout_toEndOf="@+id/resultThumbnail"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/resultArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/primary_lavender"
                android:textSize="13sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Tactile Play / Duration Pill Action -->
        <LinearLayout
            android:id="@+id/resultActionPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_play_chip"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:elevation="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/resultPlayIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_play"
                android:tint="@color/primary_bright"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/resultDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_violet"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
