<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queueItemContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_track_item_normal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="3dp">

    <!-- Active Indicator Bar on left -->
    <View
        android:id="@+id/queueActiveBar"
        android:layout_width="3dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@color/primary_cyan"
        android:visibility="gone" />

    <!-- Album Thumbnail -->
    <ImageView
        android:id="@+id/queueThumbnail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/queueActiveBar"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_album_art_placeholder"
        android:scaleType="centerCrop"
        android:clipToOutline="true" />

    <!-- Track Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/queueActionsLayout"
        android:layout_toEndOf="@+id/queueThumbnail"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queueTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/queueTrackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:fontFamily="@font/manrope"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Actions layout (duration + remove) -->
    <LinearLayout
        android:id="@+id/queueActionsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/queueDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="@font/manrope"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnQueueRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:contentDescription="Remove track" />
    </LinearLayout>

</RelativeLayout>
