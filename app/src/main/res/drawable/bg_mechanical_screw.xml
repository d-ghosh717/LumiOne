<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Inset Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A0D28" />
            <stroke android:width="1dp" android:color="#40C084FC" />
        </shape>
    </item>
    <!-- Metallic Screw Center -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#6B3A9E"
                android:centerColor="#3A1E5C"
                android:endColor="#1F0D33"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
