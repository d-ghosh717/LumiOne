<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer purple glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#50A855F7" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <!-- Bright white core with violet stroke -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#A855F7" />
        </shape>
    </item>
</layer-list>
