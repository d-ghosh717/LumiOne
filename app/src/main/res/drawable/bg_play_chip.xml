<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40C084FC">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#3B1D66"
                android:endColor="#24123F"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#66A855F7" />
        </shape>
    </item>
</ripple>
