<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlistDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPlaylistDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Playlist"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans" />

        <!-- Actions: Rename and Delete -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlaylistDetailRename"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:tint="@color/primary_cyan"
                android:contentDescription="Rename playlist" />

            <ImageButton
                android:id="@+id/btnPlaylistDetailDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:tint="@color/coral"
                android:contentDescription="Delete playlist" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Playlist Hero & Actions Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Big Cover Artwork -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playlistDetailArtworkCard"
            android:layout_width="128dp"
            android:layout_height="128dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/subtle_border"
            app:cardBackgroundColor="@color/surface_elevated">

            <ImageView
                android:id="@+id/playlistDetailFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_playlist"
                android:tint="@color/primary_cyan"
                android:padding="32dp"
                android:background="@drawable/bg_curated_tile_1"
                android:contentDescription="Playlist artwork fallback" />

            <ImageView
                android:id="@+id/playlistDetailArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Playlist artwork" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Playlist Name -->
        <TextView
            android:id="@+id/txtPlaylistDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Playlist Name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Optional Description -->
        <TextView
            android:id="@+id/txtPlaylistDetailDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Track Count & Meta -->
        <TextView
            android:id="@+id/txtPlaylistDetailTrackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 tracks • LumiOne Personal Playlist"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp"
            android:fontFamily="@font/manrope" />

        <!-- Action Buttons: Play All, Shuffle, Add Songs -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Play All -->
            <LinearLayout
                android:id="@+id/btnPlaylistDetailPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_category_pill_active"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_on_cyan"
                    android:contentDescription="Play all" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Play All"
                    android:textColor="@color/text_on_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <!-- Shuffle -->
            <LinearLayout
                android:id="@+id/btnPlaylistDetailShuffle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shuffle"
                    android:tint="@color/text_primary"
                    android:contentDescription="Shuffle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Shuffle"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <!-- Add Songs -->
            <LinearLayout
                android:id="@+id/btnPlaylistDetailAddSongs"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/primary_cyan"
                    android:contentDescription="Add songs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Add Songs"
                    android:textColor="@color/primary_cyan"
                    android:textSize="13sp"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/playlistDetailEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_playlist"
            android:tint="@color/primary_dim"
            android:contentDescription="Empty playlist icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="This playlist is empty"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Add songs from search, liked songs, or listening history."
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:fontFamily="@font/manrope" />

        <TextView
            android:id="@+id/btnPlaylistDetailEmptyAdd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_category_pill_active"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="+ Add Songs"
            android:textColor="@color/text_on_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

    <!-- Tracks RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylistTracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="240dp"
        android:overScrollMode="never" />

</LinearLayout>
