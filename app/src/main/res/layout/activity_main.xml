<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- ─── Main Content Scroll ───────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/miniPlayerCard"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- Top Branding Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOOD EVENING"
                        android:textColor="@color/primary_lavender"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LumiOne"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="-0.03" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_chip_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="STREAM"
                            android:textColor="@color/primary_violet"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/primary_lavender"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- Search Bar Pill -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_field"
                    android:hint="Search artists, tracks, soundscapes…"
                    android:textColorHint="@color/text_dim"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="52dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/primary_bright" />
            </FrameLayout>

            <!-- Section Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 Trending on Audius"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/btnSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="See all"
                    android:textColor="@color/primary_lavender"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <!-- Search Results / Trending RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchResultsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─── Floating Glass Mini Player ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/miniPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_above="@+id/bottomNavBar"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mini_player"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- Circular Album Art -->
        <ImageView
            android:id="@+id/miniAlbumArtView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_album_art_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/miniTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nothing playing"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:ellipsize="marquee" />

            <TextView
                android:id="@+id/miniArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="@color/primary_lavender"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/miniPlayPauseBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_play_button_mini"
            android:src="@drawable/ic_play"
            android:tint="@color/text_primary"
            android:contentDescription="Play/Pause" />
    </LinearLayout>

    <!-- Mini Progress Line -->
    <ProgressBar
        android:id="@+id/miniProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_above="@+id/bottomNavBar"
        android:progressDrawable="@drawable/progress_gradient"
        android:max="1000"
        android:progress="0" />

    <!-- ─── Floating Bottom Navigation Bar ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="12dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill" />

            <ImageButton
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_home"
                android:tint="@color/primary_lavender"
                android:background="@null"
                android:contentDescription="Home" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_search"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Search" />

        <ImageButton
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_library"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Library" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:tint="@color/text_muted"
            android:background="@null"
            android:contentDescription="Profile" />
    </LinearLayout>

    <!-- ─── Full Player Overlay (Inspired by Reference Turntable Deck) ───────── -->
    <FrameLayout
        android:id="@+id/fullPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_full_player_gradient"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="44dp"
                android:paddingHorizontal="24dp"
                android:paddingBottom="36dp">

                <!-- Top Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="@color/text_primary"
                        android:contentDescription="Collapse" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="NOW PLAYING"
                        android:textColor="@color/primary_lavender"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <ImageButton
                        android:id="@+id/btnMore"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_more_vert"
                        android:tint="@color/text_primary"
                        android:contentDescription="Options" />
                </RelativeLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="14dp" />

                <!-- Turntable Deck Centerpiece (Inspired by UI Reference) -->
                <FrameLayout
                    android:layout_width="290dp"
                    android:layout_height="290dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_turntable_deck"
                    android:padding="16dp">

                    <!-- Vinyl Groove Background Ring -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_album_art_large" />

                    <!-- Center Record / Artwork Disc -->
                    <ImageView
                        android:id="@+id/fullAlbumArtView"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_album_art_placeholder"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:elevation="6dp" />

                    <!-- Tone Arm / Stylus Detail Accent -->
                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_pill" />
                </FrameLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="14dp" />

                <!-- Track Metadata & Like Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/btnLike"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fullTrackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select a track"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="-0.02"
                            android:singleLine="true"
                            android:ellipsize="marquee" />

                        <TextView
                            android:id="@+id/fullArtistName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="@color/primary_lavender"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnLike"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_heart"
                        android:tint="@color/primary_lavender"
                        android:contentDescription="Favorite" />
                </RelativeLayout>

                <!-- Audio Waveform Indicator & Time Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_soundwave"
                        android:tint="@color/primary_bright"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/fullCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/primary_lavender"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / "
                            android:textColor="@color/text_dim"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope" />

                        <TextView
                            android:id="@+id/fullDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seekbar -->
                <SeekBar
                    android:id="@+id/fullSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/seekbar_gradient"
                    android:thumb="@drawable/seekbar_thumb"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingVertical="10dp"
                    android:max="1000"
                    android:layout_marginBottom="16dp" />

                <!-- Tactile Floating Control Deck (Inspired by UI Reference) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_control_deck"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="16dp">

                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text_primary"
                        android:alpha="0.4"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Previous Pill Button -->
                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="56dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_skip_prev"
                        android:tint="@color/text_primary"
                        android:background="@drawable/bg_control_pill_button"
                        android:contentDescription="Previous" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <!-- HUGE Physical Glossy Play/Pause Button (76dp) -->
                    <ImageButton
                        android:id="@+id/fullPlayPauseBtn"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_play_button_large"
                        android:src="@drawable/ic_play"
                        android:tint="@color/text_primary"
                        android:scaleType="centerInside"
                        android:elevation="10dp"
                        android:contentDescription="Play/Pause" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <!-- Next Pill Button -->
                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="56dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary"
                        android:background="@drawable/bg_control_pill_button"
                        android:contentDescription="Next" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/text_primary"
                        android:alpha="0.4"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat" />

                </LinearLayout>

                <!-- Bottom Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="8dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</RelativeLayout>
